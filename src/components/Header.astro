---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navLinks = [
  { href: "/apps/", label: "Apps", activePaths: ["/", "/apps"] },
  { href: "/consulting/", label: "Consulting", activePaths: ["/consulting"] },
  { href: "/contact/", label: "Contact", activePaths: ["/contact"] },
];

function isActive(activePaths: string[], currentPath: string): boolean {
  const normalized = currentPath.replace(/\/$/, "") || "/";
  return activePaths.includes(normalized);
}
---

<header class="w-full bg-white shadow-xs">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <a href="/" class="flex items-center space-x-2">
      <img
        src="/lovable-uploads/a28acd56-9e34-4a9e-90f3-e42bcbca4c51.png"
        alt="OwnTube.tv Logo"
        class="h-12 w-12 rounded-lg"
      />
      <span class="text-2xl font-bold text-owntube-orange">OwnTube.tv</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex space-x-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-lg",
              isActive(link.activePaths, currentPath)
                ? "text-owntube-orange font-semibold"
                : "text-gray-600 hover:text-owntube-orange",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <ot-mobile-menu class="md:hidden">
      <!-- Mobile hamburger -->

      <button
        slot="trigger"
        id="mobile-menu-toggle"
        class="p-2 text-gray-600 hover:text-owntube-orange"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <nav class="flex flex-col space-y-8 mt-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-lg",
                isActive(link.activePaths, currentPath)
                  ? "text-owntube-orange font-semibold"
                  : "text-gray-600 hover:text-owntube-orange",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </ot-mobile-menu>
  </div>

  <!-- Mobile nav without scripting: the drawer needs it, and ot-mobile-menu:not(:defined) hides the drawer until
       it has it. A browser with scripting enabled never parses this into the DOM, so it cannot shift the layout. -->
  <noscript>
    <nav class="md:hidden flex justify-center gap-6 border-t border-gray-200 px-4 py-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-lg",
              isActive(link.activePaths, currentPath)
                ? "text-owntube-orange font-semibold"
                : "text-gray-600 hover:text-owntube-orange",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </noscript>
</header>
