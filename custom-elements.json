    {
      "kind": "javascript-module",
      "path": "src/elements/ot-app-card.ts",
      "declarations": [
        {
          "kind": "class",
          "description": "Card for one featured app.\n\nThe content — artwork, icon, name, description and the store links — is rendered by Astro and stays in the light\nDOM, so it is in the page source for crawlers and keeps working without JavaScript. The element enhances it: it\npoints out the store link that matches the visitor's platform and reports link clicks.\n\nEvery link stays rendered and reachable whatever the platform; the recommendation is an addition, never a filter.",
          "name": "OtAppCard",
          "cssParts": [
            {
              "description": "The padded column below the artwork.",
              "name": "body"
            },
            {
              "description": "The \"recommended for…\" badge above the store links.",
              "name": "badge"
            }
          ],
          "slots": [
            {
              "description": "Artwork shown at the top of the card, above the body.",
              "name": "image"
            },
            {
              "description": "Body of the card: icon, name, source link and descriptions.",
              "name": ""
            },
            {
              "description": "The store links, kept last in the body.",
              "name": "links"
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "name",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Name of the app, used for the link-click event and for accessible names.",
              "default": "\"\"",
              "attribute": "name"
            },
            {
              "kind": "field",
              "name": "webLink",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Link to the web version of the app.",
              "default": "\"\"",
              "attribute": "web-link"
            },
            {
              "kind": "field",
              "name": "googleLink",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Link to the app on Google Play.",
              "default": "\"\"",
              "attribute": "google-link"
            },
            {
              "kind": "field",
              "name": "testflightLink",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Link to the app on TestFlight.",
              "default": "\"\"",
              "attribute": "testflight-link"
            },
            {
              "kind": "field",
              "name": "githubRepo",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Link to the app's source repository.",
              "default": "\"\"",
              "attribute": "github-repo"
            },
            {
              "kind": "field",
              "name": "platform",
              "privacy": "public",
              "type": {
                "text": "VisitorPlatform"
              },
              "description": "The visitor's platform. Detected from the user agent, and reflected to the attribute so it can be read — or\noverridden, which is what the tests do rather than pretending to be another device.",
              "attribute": "platform",
              "reflects": true
            },
            {
              "kind": "field",
              "name": "#recommendedHref",
              "privacy": "private",
              "type": {
                "text": "string"
              },
              "description": "The store link this visitor is most likely to want, if any.",
              "readonly": true
            },
            {
              "kind": "field",
              "name": "#markRecommendedLink",
              "privacy": "private",
              "description": "Links live in the light DOM, so the element marks them up rather than styling them from the shadow root."
            },
            {
              "kind": "field",
              "name": "#onLinkClick",
              "privacy": "private"
            },
            {
              "kind": "method",
              "name": "#links",
              "privacy": "private",
              "return": {
                "type": {
                  "text": "HTMLAnchorElement[]"
                }
              }
            },
            {
              "kind": "method",
              "name": "#platformOf",
              "privacy": "private",
              "return": {
                "type": {
                  "text": "LinkPlatform"
                }
              },
              "parameters": [
                {
                  "name": "href",
                  "type": {
                    "text": "string"
                  }
                }
              ]
            },
            {
              "kind": "method",
              "name": "#absolute",
              "privacy": "private",
              "return": {
                "type": {
                  "text": "string"
                }
              },
              "parameters": [
                {
                  "name": "href",
                  "type": {
                    "text": "string"
                  }
                }
              ],
              "description": "Anchors report absolute hrefs, so the attributes have to be resolved the same way before comparing."
            }
          ],
          "events": [
            {
              "description": "A link in the card was clicked. `detail` carries the app `name` and the `platform` the link points at, ready for analytics.",
              "name": "ot-app-link-click"
            }
          ],
          "attributes": [
            {
              "name": "name",
              "type": {
                "text": "string"
              },
              "description": "Name of the app, used for the link-click event and for accessible names.",
              "default": "\"\"",
              "fieldName": "name"
            },
            {
              "name": "web-link",
              "type": {
                "text": "string"
              },
              "description": "Link to the web version of the app.",
              "default": "\"\"",
              "fieldName": "webLink"
            },
            {
              "name": "google-link",
              "type": {
                "text": "string"
              },
              "description": "Link to the app on Google Play.",
              "default": "\"\"",
              "fieldName": "googleLink"
            },
            {
              "name": "testflight-link",
              "type": {
                "text": "string"
              },
              "description": "Link to the app on TestFlight.",
              "default": "\"\"",
              "fieldName": "testflightLink"
            },
            {
              "name": "github-repo",
              "type": {
                "text": "string"
              },
              "description": "Link to the app's source repository.",
              "default": "\"\"",
              "fieldName": "githubRepo"
            },
            {
              "name": "platform",
              "type": {
                "text": "VisitorPlatform"
              },
              "description": "The visitor's platform. Detected from the user agent, and reflected to the attribute so it can be read — or\noverridden, which is what the tests do rather than pretending to be another device.",
              "fieldName": "platform"
            }
          ],
          "superclass": {
            "name": "LitElement",
            "package": "lit"
          },
          "tagName": "ot-app-card",
          "customElement": true
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "OtAppCard",
          "declaration": {
            "name": "OtAppCard",
            "module": "src/elements/ot-app-card.ts"
          }
        },
        {
          "kind": "custom-element-definition",
          "name": "ot-app-card",
          "declaration": {
            "name": "OtAppCard",
            "module": "src/elements/ot-app-card.ts"
          }
        }
      ]
    },
