    {
      "kind": "javascript-module",
      "path": "src/elements/ot-mobile-menu.ts",
      "declarations": [
        {
          "kind": "class",
          "description": "Navigation drawer for small screens.\n\nThe links are rendered by Astro and stay in the light DOM, so they are in the page source for crawlers and keep\nworking without JavaScript; the element only moves them into a modal panel. That panel is a native `<dialog>`\nopened with `showModal()`, which gives it the `dialog` role, `aria-modal`, the top layer, `::backdrop`, Escape\nhandling and an inert page behind it.",
          "name": "OtMobileMenu",
          "cssProperties": [
            {
              "description": "Panel background.",
              "name": "--ot-color-background",
              "default": "#fff"
            },
            {
              "description": "Text colour, inherited by the slotted navigation.",
              "name": "--ot-color-foreground",
              "default": "hsl(222.2 84% 4.9%)"
            },
            {
              "description": "The overlay behind the panel.",
              "name": "--ot-color-backdrop",
              "default": "rgb(0 0 0 / 0.5)"
            },
            {
              "description": "Close button colour.",
              "name": "--ot-color-gray-600"
            },
            {
              "description": "Close button hover colour.",
              "name": "--ot-color-orange",
              "default": "#ff5722"
            },
            {
              "description": "Panel shadow.",
              "name": "--ot-shadow-lg"
            },
            {
              "description": "Spacing unit; the panel's padding is six of them.",
              "name": "--ot-space",
              "default": "0.25rem"
            }
          ],
          "cssParts": [
            {
              "description": "The full-screen dialog; its backdrop is styled with `::backdrop`.",
              "name": "dialog"
            },
            {
              "description": "The panel on the right.",
              "name": "panel"
            }
          ],
          "slots": [
            {
              "description": "The button that opens the menu. The element keeps `aria-haspopup`, `aria-expanded` and `aria-controls` in sync on it.",
              "name": "trigger"
            },
            {
              "description": "The navigation shown in the panel, typically a `<nav>` with links.",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "open",
              "privacy": "public",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "attribute": "open",
              "reflects": true
            },
            {
              "kind": "field",
              "name": "label",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "default": "\"Menu\"",
              "attribute": "label"
            },
            {
              "kind": "field",
              "name": "#onToggle",
              "privacy": "private"
            },
            {
              "kind": "field",
              "name": "#onClose",
              "privacy": "private"
            },
            {
              "kind": "field",
              "name": "#onDialogClick",
              "privacy": "private"
            },
            {
              "kind": "field",
              "name": "#onCancel",
              "privacy": "private"
            },
            {
              "kind": "field",
              "name": "#onDialogClose",
              "privacy": "private"
            },
            {
              "kind": "method",
              "name": "#syncTrigger",
              "privacy": "private",
              "description": "`aria-controls` targets the slotted navigation, and names it when the consumer has not: an IDREF cannot cross\nthe shadow boundary."
            },
            {
              "kind": "method",
              "name": "#syncDialog",
              "privacy": "private",
              "description": "`open` is the single source of truth: the dialog follows it, and focus follows the dialog.\n\nNo focus trap of our own. `showModal()` makes everything outside the dialog inert, verified in Chromium,\nFirefox and WebKit: nothing behind it takes focus, by Tab or by a script calling `focus()`. Tabbing past the\nlast element reaches the browser's own UI and comes back, which is a reasonable way out for the user; a\nhand-written trap would only take that away."
            },
            {
              "kind": "method",
              "name": "#dispatchChange",
              "privacy": "private"
            },
            {
              "kind": "field",
              "name": "#trigger",
              "privacy": "private",
              "type": {
                "text": "HTMLElement | undefined"
              },
              "readonly": true
            },
            {
              "kind": "method",
              "name": "#assigned",
              "privacy": "private",
              "return": {
                "type": {
                  "text": "Element[]"
                }
              },
              "parameters": [
                {
                  "name": "slotSelector",
                  "type": {
                    "text": "string"
                  }
                }
              ]
            },
            {
              "kind": "field",
              "name": "#mql",
              "privacy": "private"
            },
            {
              "kind": "field",
              "name": "#onBreakpoint",
              "privacy": "private"
            }
          ],
          "events": [
            {
              "description": "The menu opened. Bubbles and is composed, so it can be heard on `document`.",
              "name": "ot-menu-open"
            },
            {
              "description": "The menu closed. Neither event fires while the element renders for the first time.",
              "name": "ot-menu-close"
            }
          ],
          "attributes": [
            {
              "name": "open",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "fieldName": "open"
            },
            {
              "name": "label",
              "type": {
                "text": "string"
              },
              "default": "\"Menu\"",
              "fieldName": "label"
            }
          ],
          "superclass": {
            "name": "LitElement",
            "package": "lit"
          },
          "tagName": "ot-mobile-menu",
          "customElement": true
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "OtMobileMenu",
          "declaration": {
            "name": "OtMobileMenu",
            "module": "src/elements/ot-mobile-menu.ts"
          }
        },
        {
          "kind": "custom-element-definition",
          "name": "ot-mobile-menu",
          "declaration": {
            "name": "OtMobileMenu",
            "module": "src/elements/ot-mobile-menu.ts"
          }
        }
      ]
    },
